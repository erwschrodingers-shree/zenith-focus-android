<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zenith" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/saffron_orange</item>
        <item name="android:colorAccent">@color/saffron_orange</item>
        <item name="android:windowBackground">@color/off_white</item>
    </style>

    <style name="Theme.Zenith.FullScreen" parent="Theme.Zenith">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
